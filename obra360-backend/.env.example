# Template de Variáveis de Ambiente do Obra360 Backend (.env.example)
# Copie este arquivo para .env e preencha com as credenciais reais do seu ambiente local/produção

# Configurações do Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/obra360_db
SPRING_DATASOURCE_USERNAME=obra360_user
SPRING_DATASOURCE_PASSWORD=sua_senha_segura_aqui

# Configurações do Barramento Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Criptografia e Segurança JWT (Gere uma chave HMAC-SHA512 aleatória de 64 bytes)
JWT_SECRET=substitua_por_uma_chave_secreta_aleatoria_com_no_minimo_64_caracteres
JWT_EXPIRATION_MS=86400000

# Configurações CORS
CORS_ALLOWED_ORIGINS=https://app.obra360.com.br,http://localhost:3000
