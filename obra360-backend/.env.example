# Copie para .env. npm run dev carrega; Maven direto requer ambiente do processo.
APP_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PostgreSQL: SPRING_PROFILES_ACTIVE=prod e SPRING_DATASOURCE_URL/USERNAME/PASSWORD
# JWT_SECRET deve ser definido em produção. Nunca versionar segredos.
DOCUMENT_STORAGE=local
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=800
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=
SEFAZ_ENABLED=false
SEFAZ_URL=
SEFAZ_A1_PATH=
SEFAZ_A1_PASSWORD=
SEFAZ_EMPRESA_ID=
SEFAZ_AMBIENTE=2
# Base64 de 32 bytes aleatórios. Guarde fora do banco e inclua na recuperação de desastre.
# Alterar/perder esta chave impede ler os autenticadores já cadastrados.
MFA_ENCRYPTION_KEY=
