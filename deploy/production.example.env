# Copie para .env.production em local privado e preencha.
APP_DOMAIN=
POSTGRES_PASSWORD=
JWT_SECRET=
EMAIL_ENABLED=false
DOCUMENT_STORAGE_MAX_BYTES=10737418240
# 0 mantém a quota global; defina bytes positivos para limitar novos arquivos por empresa.
DOCUMENT_STORAGE_TENANT_MAX_BYTES=0
SHARED_USAGE_LIMITS_ENABLED=true
# Gere um segredo aleatório próprio (mínimo 32 bytes), diferente do JWT e da senha do banco.
SHARED_USAGE_LIMITS_SECRET=
# Kafka interno é habilitado somente com compose.production.messaging.yml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=

# Caminho privado do relatório de aceite preenchido pelo responsável.
PRODUCTION_PILOT_REPORT=
# Evidência de dependências e binário exato da entrega (não preencher com flags).
PRODUCTION_RELEASE_JAR=
PRODUCTION_DEPENDENCY_REPORT=
