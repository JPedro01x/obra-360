{
  "strixVersion": "3.2.0",
  "project": "Obra 360",
  "securityPolicies": {
    "sast": {
      "enabled": true,
      "rules": [
        "OWASP-A01-BROKEN-ACCESS-CONTROL",
        "OWASP-A02-CRYPTOGRAPHIC-FAILURES",
        "OWASP-A03-INJECTION-PREVENTION",
        "OWASP-A04-INSECURE-DESIGN",
        "OWASP-A05-SECURITY-MISCONFIGURATION",
        "OWASP-A07-IDENTIFICATION-AUTH-FAILURES"
      ],
      "checkSecretsInCode": true,
      "requireBcryptHash": true,
      "requireJwtStateless": true
    },
    "dast": {
      "enabled": true,
      "targetUrl": "http://localhost:8080",
      "scanRoutes": [
        "/api/v1/auth/login",
        "/api/v1/nfe/conciliar",
        "/api/v1/estoque/movimentacao/nfe",
        "/api/v1/cronograma/etapas",
        "/actuator/health"
      ],
      "rateLimitCheck": true,
      "tenantIsolationCheck": true
    }
  },
  "reporting": {
    "outputFormat": "json",
    "reportFile": "strix-security-report.json",
    "failOnSeverity": "CRITICAL"
  }
}
