projeto_obra ||--o{ diario_obra : "registra RDO (B2->B5)"
projeto_obra ||--o{ ocorrencia_qualidade : "inconformidades (B2->B6)"
projeto_obra ||--o{ medicao_servico : "boletins medicao (B2->B6)"
