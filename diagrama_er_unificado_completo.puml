projeto_obra ||--o{ mensagem_chat : "canal da obra (B2->B8)"

' --- 4. Relações de Suprimentos, Compras & Almoxarifado (Bloco 3) ---
item_material ||--o{ estoque_obra : "saldo fisico"
item_material ||--o{ movimentacao_estoque : "movimenta item"
estoque_obra ||--o{ movimentacao_estoque : "kardex local"

item_material ||--o{ solicitacao_compra : "item requisitado"
solicitacao_compra ||--o{ cotacao_b2b : "agrupa em RFQ"
cotacao_b2b ||--o{ proposta_fornecedor : "recebe ofertas"
