proposta_fornecedor ||--o{ pedido_compra : "gera pedido"

' --- 5. Relações Fiscais e Recebimento SEFAZ (Bloco 4) ---
pedido_compra ||--o{ conciliacao_nfe : "faturado por (B3->B4)"
conciliacao_nfe ||--o{ item_nfe : "discrimina itens"
item_material ||--o{ item_nfe : "vinculo catalogo (B3->B4)"

